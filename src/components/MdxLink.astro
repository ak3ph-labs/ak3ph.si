---
// Links inside MDX write-ups: external ones open in a new tab, like the rest of the site.
import ExtLink from './ExtLink.astro';

interface Props {
  href: string;
  [key: string]: unknown;
}

const { href, ...rest } = Astro.props;
const external = /^https?:\/\//.test(href) && !href.startsWith(Astro.site!.origin);
---

{
  external ? (
    <ExtLink href={href} {...rest}>
      <slot />
    </ExtLink>
  ) : (
    <a href={href} {...rest}>
      <slot />
    </a>
  )
}
